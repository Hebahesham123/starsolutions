# Supabase — copy this file to .env.local and fill in your project values.
# The site runs fine without them: it falls back to the bundled seed data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key, used by the contact form route to insert leads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta Pixel + Conversions API. Leave empty to disable tracking.
NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id
# Server-only. Events Manager -> your pixel -> Settings -> Conversions API -> Generate access token.
META_CAPI_ACCESS_TOKEN=your-capi-access-token
# Optional: code from Events Manager -> Test events. Remove once events show up correctly.
META_TEST_EVENT_CODE=
# Optional: Graph API version (defaults to v23.0).
META_GRAPH_VERSION=
